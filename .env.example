# Flask session signing key. Generate a real one for any real event:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-any-real-event

# SQLite for the local demo (default if unset). For production, point this at
# a managed Postgres instance, e.g.:
#   postgresql://user:password@host:5432/devcrypt
DATABASE_URL=sqlite:///devcrypt.db

# HMAC salt used to derive fragment values (team_id + mission_id -> cipher_value),
# and the secret FinalFlagService combines with the booth Mission ids to derive the
# final-flag decryption key. Generate a fresh one per event so fragments/flag can't
# be pre-computed across events:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
EVENT_SALT=change-me-per-event

# Server-only final-flag material. Leave BOTH unset for local dev/demo (the final-flag
# routes just 404 — safe, feature unavailable). For a real event, generate them together
# by running scripts/derive_final_flag.py against this environment's EVENT_SALT above:
#   python3 scripts/derive_final_flag.py --flag "..." --mission-ids <real Mission ids>
# Paste the two lines it prints. Must always be regenerated together — a mismatched
# EVENT_SALT/CIPHERTEXT/MISSION_IDS combo fails closed (500), never returns a wrong flag.
# FINAL_FLAG_CIPHERTEXT=
# FINAL_FLAG_MISSION_IDS=

# Restricts which origin(s) may call the player-facing REST API (/missions/*,
# /auth/csrf-token) cross-origin -- the URL of the Vercel-hosted React player dashboard
# (frontend/), NOT Socket.IO's CORS setting (that's hardcoded permissive; see
# SOCKETIO_CORS_ALLOWED_ORIGINS in app/config.py -- GM/Agent/Security/mod/leaderboard stay
# same-origin to this backend and don't need this var at all). Comma-separated for more than
# one origin. Leave unset ("*") for local demos. For production, set this to your deployed
# Vercel URL, e.g.:
#   ALLOWED_ORIGIN=https://your-app.vercel.app
ALLOWED_ORIGIN=*

# Where an authenticated team's browser is sent after login -- the Vercel-hosted player
# dashboard. Defaults to Vite's local dev server for local development. For production, set
# this to the same URL as ALLOWED_ORIGIN above:
#   VERCEL_APP_URL=https://your-app.vercel.app
VERCEL_APP_URL=http://localhost:5173
