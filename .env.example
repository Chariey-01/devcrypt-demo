# Flask session signing key. Generate a real one for any real event:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-any-real-event

# SQLite for the local demo (default if unset). For production, point this at
# a managed Postgres instance, e.g.:
#   postgresql://user:password@host:5432/devcrypt
DATABASE_URL=sqlite:///devcrypt.db

# HMAC salt used to derive fragment values (team_id + mission_id -> cipher_value).
# Generate a fresh one per event so fragments can't be pre-computed across events:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
EVENT_SALT=change-me-per-event

# Restricts which origins may open a Socket.IO WebSocket connection (the handshake carries
# the session cookie, so this matters the same way CORS matters for any cookie-authenticated
# endpoint). Leave unset for local demos. For production, set this to your actual deployed
# URL, e.g.:
#   ALLOWED_ORIGIN=https://devcrypt.up.railway.app
ALLOWED_ORIGIN=*
